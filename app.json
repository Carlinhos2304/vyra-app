{
  "expo": {
    "name": "vyra-app",
    "slug": "vyra-app",
    "scheme": "vyra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_white.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo_black.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_black.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.vyraapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vyra uses your location to show accurate local weather for your outfit recommendations."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon_white.png",
          "color": "#1C1917"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2b91b79-167d-42dd-984d-7f221f5c9b41"
      },
      "googleWebClientId": "726764972468-rikkfh0j3v9nhb5flipabkr8vvj7dujn.apps.googleusercontent.com"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a2b91b79-167d-42dd-984d-7f221f5c9b41"
    }
  }
}
